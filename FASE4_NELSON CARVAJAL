# EXCEPCIONES

class ErrorSistema(Exception):
      "Clase base para los errores propios del sistema"

class DatoInvalidoError(ErrorSistema):
     "Se genera cuando un dato no existe o es invalido"

class ServicioNoDisponibleError(ErrorSistema):
      "Se genera cuando un servicio no está disponible"

class ReservaError(ErrorSistema):
      "Se genera cuando no se puede realizar una reserva"


#CLASE ABSTRACTA ENTIDAD

class Entidad(ABC):
    """Representa una entidad general del sistema."""

    def __init__(self, identificacion, nombre):
        if not identificacion or not str(identificacion).strip():
            raise DatoInvalidoError("La identificación es obligatoria.")

        if not nombre or not nombre.strip():
            raise DatoInvalidoError("El nombre es obligatorio.")

        self.__identificacion = str(identificacion).strip()
        self.__nombre = nombre.strip()

    @property
    def identificacion(self):
        return self.__identificacion

    @property
    def nombre(self):
        return self.__nombre

    @abstractmethod
    def mostrar_informacion(self):
        """Cada entidad concreta debe mostrar su información."""
        pass

# CLASE CLIENTE

class Cliente(Entidad):
     def __init__(self, identificacion, nombre, correo, telefono):
          super().__init__(identificacion, nombre, correo, telefono)

          if not correo or "@" not in correo or "." not in correo:
               raise DatoInvalidoError("El correo electrónico no es válido")
          if not telefono or not str(telefono).isdigit() or len(str(telefono)) <10:
               raise DatoInvalidoError("El teléfono debe contener al menos 10 digitos numéricos")
          self.__correo = correo.strip()
          self.__telefono = str(telefono)
            
     @property
     def correo(self):
          return self.__correo
            
     @property
     def telefono(self):
          return self.__telefono
            
     def mostrar_informacion(self):
          return (f"Cliente: {self.nombre} | ID: {self.identificacion} | "
                  f"Correo: {self.correo} | Teléfono: {self.telefono}")

# CLASE ABSTRACTA SERVICIO

class Servicio(ABC):
    def __init__(self, codigo, nombre, tarifa, disponible=True):
        if not codigo or not str(codigo).strip():
            raise DatoInvalidoError("El código del servicio es obligatorio.")

        if not nombre or not nombre.strip():
            raise DatoInvalidoError("El nombre del servicio es obligatorio.")

        if not isinstance(tarifa, (int, float)) or tarifa <= 0:
            raise DatoInvalidoError("La tarifa debe ser un número mayor que cero.")

        self.__codigo = str(codigo).strip()
        self.__nombre = nombre.strip()
        self.__tarifa = float(tarifa)
        self.__disponible = bool(disponible)

    @property
    def codigo(self):
        return self.__codigo

    @property
    def nombre(self):
        return self.__nombre

    @property
    def tarifa(self):
        return self.__tarifa

    @property
    def disponible(self):
        return self.__disponible

    def cambiar_disponibilidad(self, estado):
        self.__disponible = bool(estado)

    def validar_disponibilidad(self):
        if not self.__disponible:
            raise ServicioNoDisponibleError(
                f"El servicio '{self.__nombre}' no está disponible.")

    @abstractmethod
    def calcular_costo(self, cantidad, impuesto=0, descuento=0):
        pass
    @abstractmethod
    def describir(self):
        pass

# SERVICIO 1 _ RESERVA DE SALAS

class ReservaSala(Servicio):
    def __init__(self, codigo, nombre, tarifa_hora, capacidad, disponible=True):
        super().__init__(codigo, nombre, tarifa_hora, disponible)

        if not isinstance(capacidad, int) or capacidad <= 0:
            raise DatoInvalidoError("La capacidad debe ser un entero positivo.")

        self.__capacidad = capacidad

    def calcular_costo(self, cantidad, impuesto=0, descuento=0):
        self.validar_disponibilidad()
        if not isinstance(cantidad, (int, float)) or cantidad <= 0:
            raise DatoInvalidoError("Las horas deben ser mayores que cero.")
        if impuesto < 0 or descuento < 0 or descuento > 100:
            raise DatoInvalidoError("Impuesto o descuento fuera de rango.")

        subtotal = self.tarifa * cantidad
        return subtotal * (1 + impuesto / 100) * (1 - descuento / 100)

    def describir(self):
        return (
            f"Sala: {self.nombre} | Tarifa por hora: ${self.tarifa:,.0f} | "
            f"Capacidad: {self.__capacidad} personas")

    def validar_parametros(self, personas):
        if not isinstance(personas, int) or personas <= 0:
            raise DatoInvalidoError("La cantidad de personas debe ser positiva.")
        if personas > self.__capacidad:
            raise DatoInvalidoError(
                f"La sala admite máximo {self.__capacidad} personas.")

# SERVICO 2 _ ALQUIKER DE EQUIPOS

class AlquilerEquipos(Servicio):
    def __init__(self, codigo, nombre, tarifa_dia, cantidad_disponible,
                 disponible=True):
        super().__init__(codigo, nombre, tarifa_dia, disponible)

        if not isinstance(cantidad_disponible, int) or cantidad_disponible < 0:
            raise DatoInvalidoError("La cantidad disponible debe ser un entero igual o mayor que cero.")

        self.__cantidad_disponible = cantidad_disponible

    def calcular_costo(self, cantidad, impuesto=0, descuento=0):
        self.validar_disponibilidad()
        if not isinstance(cantidad, (int, float)) or cantidad <= 0:
            raise DatoInvalidoError("Los días deben ser mayores que cero.")
        if impuesto < 0 or descuento < 0 or descuento > 100:
            raise DatoInvalidoError("Impuesto o descuento fuera de rango.")

        subtotal = self.tarifa * cantidad
        return subtotal * (1 + impuesto / 100) * (1 - descuento / 100)

    def describir(self):
        return (f"Equipo: {self.nombre} | Tarifa por día: ${self.tarifa:,.0f} | "
            f"Unidades disponibles: {self.__cantidad_disponible}")

    def validar_parametros(self, unidades):
        if not isinstance(unidades, int) or unidades <= 0:
            raise DatoInvalidoError("Las unidades deben ser un entero positivo.")
        if unidades > self.__cantidad_disponible:
            raise ServicioNoDisponibleError(f"Solo hay {self.__cantidad_disponible} unidades disponibles.")
