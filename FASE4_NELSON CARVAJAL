# EXCEPCIONES

class ErrorSistema(Exception):
      "Clase base para los errores propios del sistema"

class DatoInvalidoError(ErrorSistema):
     "Se genera cuando un dato no existe o es invalido"

class ServicioNoDisponibleError(ErrorSistema):
      "Se genera cuando un servicio no está disponible"

class ReservaError(ErrorSistema):
      "Se genera cuando no se puede realizar una reserva"


#CLASE ABSTRACTA ENTIDAD

class Entidad(ABC):
    """Representa una entidad general del sistema."""

    def __init__(self, identificacion, nombre):
        if not identificacion or not str(identificacion).strip():
            raise DatoInvalidoError("La identificación es obligatoria.")

        if not nombre or not nombre.strip():
            raise DatoInvalidoError("El nombre es obligatorio.")

        self.__identificacion = str(identificacion).strip()
        self.__nombre = nombre.strip()

    @property
    def identificacion(self):
        return self.__identificacion

    @property
    def nombre(self):
        return self.__nombre

    @abstractmethod
    def mostrar_informacion(self):
        """Cada entidad concreta debe mostrar su información."""
        pass
# CLASE CLIENTE

class Cliente(Entidad):
     def __init__(self, identificacion, nombre, correo, telefono):
          super().__init__(identificacion, nombre, correo, telefono)

          if not correo or "@" not in correo or "." not in correo:
               raise DatoInvalidoError("El correo electrónico no es válido")
          if not telefono or not str(telefono).isdigit() or len(str(telefono)) <10:
               raise DatoInvalidoError("El teléfono debe contener al menos 10 digitos numéricos")

